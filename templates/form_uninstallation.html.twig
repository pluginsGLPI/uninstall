{% if supported %}
    <form action="{{ action_url }}" method="post">
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
        <input type="hidden" name="device_type" value="{{ device_type }}">
        <table class="tab_cadre_fixe" cellpadding="5">
            <tr>
                <th colspan="3">{{ __('Apply model', 'uninstall') }}</th>
            </tr>
            <tr class="tab_bg_1">
                <td>{{ __('Model') }}</td>
                <td>{{ model_dropdown|raw }}</td>
            </tr>
            <tr class="tab_bg_1">
                <td>{{ __("Item's location after applying model", 'uninstall') }}</td>
                <td>{{ location_html|raw }}</td>
            </tr>
            <tr class="tab_bg_1 center">
                <td colspan="3">
                    <input type="submit" name="uninstall" value="{{ _x('button', 'Post') }}" class="submit">
                    <input type="hidden" name="id" value="{{ item_id }}">
                </td>
            </tr>
        </table>
    </form>
    {{ onselect_js|raw }}
{% endif %}
